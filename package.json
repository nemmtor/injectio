{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "injectio",
  "version": "0.0.0",
  "private": true,
  "description": "Summon React components on demand",
  "keywords": [
    "effect",
    "inject",
    "modal",
    "overlay",
    "react"
  ],
  "license": "MIT",
  "author": "nemmtor",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemmtor/injectio"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "check": "pnpm check-types && pnpm check-format && pnpm lint && pnpm test && pnpm knip && pnpm check-monorepo",
    "check-types": "turbo check-types --continue && tsc --project e2e",
    "check-format": "oxfmt --check",
    "knip": "knip",
    "check-monorepo": "manypkg check",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "format": "oxfmt",
    "lint": "oxlint -c .oxlintrc.json --import-plugin --type-aware",
    "lint:fix": "oxlint -c .oxlintrc.json --import-plugin --type-aware --fix",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.47.2",
    "@manypkg/cli": "^0.25.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "catalog:",
    "knip": "^6.39.0",
    "lefthook": "^2.1.15",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.6",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
