{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@injectio/react",
  "version": "0.0.0",
  "description": "Summon React components on demand",
  "keywords": [
    "declarative",
    "drawer",
    "effect",
    "headless",
    "inject",
    "injectio",
    "modal",
    "overlay",
    "portal",
    "react",
    "render",
    "toast",
    "typescript",
    "ui",
    "workflow"
  ],
  "homepage": "https://github.com/nemmtor/injectio",
  "bugs": {
    "url": "https://github.com/nemmtor/injectio/issues"
  },
  "license": "MIT",
  "author": "nemmtor",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemmtor/injectio.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "del-cli dist coverage tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "del-cli": "catalog:",
    "effect": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "react": ">=18 <20"
  }
}
